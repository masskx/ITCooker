# ==================== MinerU 文档解析服务 ====================
# 密钥获取: https://mineru.net/
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=

# ==================== MinIO 配置 ====================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base
MINIO_SECURE=False
# 图片上传目录（MinIO 内路径）
MINIO_IMG_DIR=

# ==================== LLM 配置（硅基流动 SiliconFlow，Qwen 系列）=======================
# 密钥获取: https://cloud.siliconflow.cn/account/ak
# 模型列表: https://cloud.siliconflow.cn/models
OPENAI_API_BASE=https://api.siliconflow.cn/v1
OPENAI_API_KEY=
# 视觉语言模型（图片理解/摘要）
VL_MODEL=Qwen/Qwen3-Omni-30B-A3B-Instruct
# 默认对话模型
LLM_DEFAULT_MODEL=Qwen/Qwen3.5-122B-A10B
# 商品/产品名称识别模型
ITEM_MODEL=Qwen/Qwen3-8B
LLM_DEFAULT_TEMPERATURE=0.1

# ==================== Milvus 向量数据库配置 ====================
# 需先通过 docker-compose 启动（etcd + minio + milvus）
MILVUS_URL=http://localhost:19530
CHUNKS_COLLECTION=chunks
ITEM_NAME_COLLECTION=item_names
ENTITY_NAME_COLLECTION=entity_names

# ==================== 向量化配置 ====================
# BGE 嵌入向量维度
EMBEDDING_DIM=1024
